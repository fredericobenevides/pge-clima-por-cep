@base_url = http://localhost:8080/weather
# @base_url = https://pge-clima-por-cep-841576980828.us-central1.run.app/weather

# Busca informações do clima para o CEP 01001000
GET {{base_url}}/01001000
Content-Type: application/json

### Not found CEP
GET {{base_url}}/11111111
Content-Type: application/json

### Test fetching weather for a valid CEP with invalid format
GET {{base_url}}/01.001-000
Content-Type: application/json